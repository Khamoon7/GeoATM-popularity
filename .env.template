# =========================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =========================================================
# 📌 Этот файл — ШАБЛОН.
# Скопируйте его в `.env` и заполните значениями.
#
# ❗ Никогда не коммитьте `.env` в репозиторий
# =========================================================


# =========================================================
# 🌍 Yandex Maps / Geocoder
# =========================================================
# API-ключ для Yandex HTTP Geocoder
#
# Используется для:
# - геокодинга адресов → координаты
# - обратного геокодинга координат → адрес
#
# Где получить:
# https://developer.tech.yandex.ru/services/3
#
# Пример:
# YANDEX_GEOCODER_API_KEY="abcdef123456"
# ---------------------------------------------------------
YANDEX_GEOCODER_API_KEY=""


# =========================================================
# 🚀 FastAPI application settings
# =========================================================
# Окружение приложения:
# - local — локальная разработка
# - dev   — тестовое окружение
# - prod  — продакшн
# ---------------------------------------------------------
APP_ENV=local

# Хост FastAPI сервиса
API_HOST=0.0.0.0

# Порт FastAPI сервиса
API_PORT=8000


# =========================================================
# 🗄 Database
# =========================================================
# Строка подключения к БД
#
# Примеры:
# SQLite:  sqlite:///./app.db
# ---------------------------------------------------------
DATABASE_URL=sqlite:///./app.db


# =========================================================
# 🧾 Request history & maintenance
# =========================================================
# Токен подтверждения для DELETE /history
# Передаётся в заголовке:
# X-Confirm-Token: <HISTORY_DELETE_TOKEN>
#
# ❗ В проде ОБЯЗАТЕЛЬНО поменять
# ---------------------------------------------------------
HISTORY_DELETE_TOKEN=super-secret-token


# =========================================================
# 📊 ML / Feature processing
# =========================================================
# Список бинарных признаков,
# которые будут приведены к float в sklearn Pipeline
#
# Используется в:
# - BinaryToFloat transformer
#
# Формат:
# через запятую, без пробелов
# ---------------------------------------------------------
ATM_BIN_FEATURES=is_24_7,contactless_tech,qr_codes,usd_available,eur_available,cash_in,cash_out,cashless_pay,account_statement,access_for_disabled,transfer_p2p,transfer_a2a,loan_payments,has_subway_nearby


# =========================================================
# 🪵 Logging
# =========================================================
# Уровень логирования:
# - DEBUG    — максимальная детализация
# - INFO     — стандартный режим
# - WARNING  — только предупреждения
# - ERROR    — только ошибки
# ---------------------------------------------------------
LOG_LEVEL=INFO


# =========================================================
# 🧪 MLflow — трекинг экспериментов
# =========================================================
# Порт, на котором будет доступен MLflow UI
# http://localhost:<MLFLOW_PORT>
# ---------------------------------------------------------
MLFLOW_PORT=5050


# =========================================================
# 🗄 PostgreSQL — бэкенд MLflow
# =========================================================
# MLflow хранит метаданные экспериментов (параметры,
# метрики, теги) в PostgreSQL
# ---------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlflow


# =========================================================
# 🪣 MinIO — S3-совместимое хранилище артефактов
# =========================================================
# Артефакты (модели, графики, примеры предсказаний)
# сохраняются в локальный MinIO-бакет
#
# S3_API_PORT  — порт MinIO S3 API (используется MLflow)
# S3_UI_PORT   — порт веб-консоли MinIO
#                http://localhost:<S3_UI_PORT>
#                логин/пароль: MINIO_ROOT_USER / MINIO_ROOT_PASSWORD
#
# MLFLOW_S3_ENDPOINT_URL — адрес MinIO внутри docker-сети
#                          не менять без необходимости
# ---------------------------------------------------------
S3_API_PORT=9000
S3_UI_PORT=9001

MLFLOW_S3_ENDPOINT_URL="http://minio:9000"
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
DEFAULT_BUCKET_NAME=mlflow-bucket
