# =========================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =========================================================
# Этот файл является шаблоном.
# Скопируйте его в .env и заполните значениями.
#
# ❗ НЕ коммитьте .env в репозиторий
# =========================================================


# ---------------------------------------------------------
# Yandex Maps / Geocoder
# ---------------------------------------------------------
# API-ключ для Yandex HTTP Geocoder
#
# Используется для:
# - геокодинга адресов → координаты
# - обратного геокодинга координат → адрес
#
# Где получить:
# https://developer.tech.yandex.ru/services/3
#
# Формат:
# YANDEX_GEOCODER_API_KEY=xxxxxxxxxxxxxxxxxxxx
YANDEX_GEOCODER_API_KEY=


# ---------------------------------------------------------
# FastAPI service configuration
# ---------------------------------------------------------
# Окружение приложения:
# local — локальная разработка
# dev   — тестовое окружение
# prod  — продакшн
APP_ENV=local

# Хост, на котором будет запущен FastAPI
API_HOST=0.0.0.0

# Порт FastAPI сервиса
API_PORT=8000


# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
# Уровень логирования:
# DEBUG    — подробные логи (разработка)
# INFO     — стандартный режим
# WARNING  — только предупреждения
# ERROR    — только ошибки
LOG_LEVEL=INFO

